#
# systemd unit for the PYNE Pro API on the Hetzner VPS (pynescript.online).
# Installed by scripts/deploy_vps.sh into /etc/systemd/system/ (together with
# the pynescript-api.service.d/cors.conf drop-in). Assumes the /root/pynescript
# checkout layout with a .venv beside it.
#
# Worker recycling (--max-requests) is load-bearing, not tuning trivia:
# gevent workers accumulate memory across compile/backtest requests (Numba,
# result caches). Without recycling two workers grew past 1.6 GB each on a
# 3.8 GB box, swap filled 100%, and even GET /health took 6–14 s — AXIS
# reported the engine as down. Recycle bounds growth; steady state is << 1 GB.
#
# NOTE: keep ExecStart in sync with
# deploy/pynescript-api.service.d/tuning.conf (drop-in wins on conflict).
# Both must contain --max-requests so a stale drop-in can never disable
# recycling (2026-10-03 outage). scripts/deploy_vps.sh installs both.

# ONE worker, deliberately. The live-session endpoints (/session,
# /session/<id>/append, /session/<id>/tick) keep a parsed script, its series,
# and TA state alive in process so a re-tick costs O(1) instead of re-evaluating
# every bar. That state is per-process, so a second worker would 404 on roughly
# half of all follow-up calls — a session created on one worker is invisible on
# the other. Single-worker is what makes the endpoint correct.
#
# Live path is Docker compose (gthread). This unit is retired; if it is
# re-enabled it must stay gthread — gevent-websocket corrupts flask-sock frames
# after a successful 101. If you raise -w above 1, the session routes must
# move to an external store first.
#
# -w 2 was the previous value. Raising it without moving session state out of
# the process is a correctness regression, not a tuning change.

[Unit]
Description=Pynescript Pro API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/pynescript
Environment=HOST=127.0.0.1
Environment=PORT=5002
Environment="ALLOWED_ORIGINS=https://pynescript.online,https://axis.hoox.sh,https://hoox.sh,https://hoox.sh/axis"
ExecStart=/root/pynescript/.venv/bin/gunicorn -k gthread --threads 100 -w 1 -b 127.0.0.1:5002 --timeout 180 --graceful-timeout 30 --keep-alive 15 --max-requests 5000 --max-requests-jitter 200 backend.app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
Environment=MPLCONFIGDIR=/root/.cache/pynescript/mpl
ReadWritePaths=/root/pynescript /root/.cache/pynescript /root/.gunicorn /tmp

[Install]
WantedBy=multi-user.target
